# Build output and dependencies
dist/
node_modules/

# Markdown is deliberately excluded.
#
# CHANGELOG.md is parsed at build time by src/utils/changelog.js, which relies on
# the exact shape of its headings, bullets, and two-space continuation lines.
# Prettier reflows and re-indents markdown, which would silently break the
# release notes panel. Markdown is written by hand here, so formatting it buys
# nothing and risks that.
*.md

# Lockfiles are generated by npm.
package-lock.json
